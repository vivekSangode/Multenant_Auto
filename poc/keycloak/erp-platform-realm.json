{
  "realm": "erp-platform",
  "displayName": "Nyaalkaran ERP - Platform",
  "enabled": true,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "PLATFORM_SUPER_ADMIN", "description": "Platform Super Admin (CD-04)" },
      { "name": "PLATFORM_ADMIN", "description": "Platform Admin" }
    ]
  },
  "clients": [
    {
      "clientId": "platform-console",
      "name": "Platform console",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience nyaalkaran-erp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nyaalkaran-erp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-vehicle",
      "name": "VEHICLE-SERVICE (M2M)",
      "publicClient": false,
      "secret": "svc-vehicle-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        { "name": "audience nyaalkaran-erp", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "nyaalkaran-erp", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }
      ]
    },
    {
      "clientId": "svc-inventory",
      "name": "INVENTORY-SERVICE (M2M)",
      "publicClient": false,
      "secret": "svc-inventory-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        { "name": "audience nyaalkaran-erp", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "nyaalkaran-erp", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }
      ]
    },
    {
      "clientId": "svc-booking",
      "name": "BOOKING-SERVICE (M2M)",
      "publicClient": false,
      "secret": "svc-booking-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        { "name": "audience nyaalkaran-erp", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "nyaalkaran-erp", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }
      ]
    }
  ],
  "users": [
    {
      "username": "superadmin",
      "email": "superadmin@platform.test",
      "firstName": "Platform",
      "lastName": "Super Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "change-me", "temporary": false } ],
      "realmRoles": ["PLATFORM_SUPER_ADMIN"]
    }
  ]
}
